default:
    @just --list

[private]
cook mod:
    @if ! stow -R --no-folding --target="$HOME" "{{ mod }}"; then \
        dunstify -u critical -a user "dot error" "{{ mod }}"; \
        exit 1; \
    fi

[private]
wipe mod:
    @if ! stow -D --target="$HOME" "{{ mod }}"; then \
        dunstify -u critical -a user "dot error" "{{ mod }}"; \
        exit 1; \
    fi

all: alacritty battery firefox btop camera cli clipboard dmentia dunst fastfetch fuzzel git hypr ide mpv nvim radio record ripgrep rqbit scrcpy shell sync theme tpl vpn xdg xkb yazi

__bin__:
    just cook __bin__

alacritty:
