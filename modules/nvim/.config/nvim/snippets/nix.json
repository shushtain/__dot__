{
  "mod": {
    "prefix": "~mod",
    "body": [
      "{",
      "\tconfig,",
      "\tlib,",
      "\tpkgs,",
      "\tcurrentUser,",
      "\t...",
      "}:",
      "let",
      "\tmod = config.modules.${1:mod};",
      "in",
      "{",
      "\toptions = {",
      "\t\tmodules.${1}.enable = lib.mkEnableOption \"${1}\";",
      "\t};",
      "",
      "\tconfig = lib.mkIf mod.enable {",
      "\t\tusers.users.\\${currentUser}.packages = [",
      "\t\t\tpkgs.${1}${0}",
      "\t\t];",
      "\t};",
      "}"
    ]
  }
}
