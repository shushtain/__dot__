{
  "mod": {
    "prefix": "~mod",
    "body": [
      "{",
      "\tconfig,",
      "\tlib,",
      "\tpkgs,",
      "\tcurrentUser,",
      "\t...",
      "}:",
      "let",
      "\tmod = config.modules.${TM_FILENAME_BASE};",
      "in",
      "{",
      "\toptions = {",
      "\t\tmodules.${TM_FILENAME_BASE}.enable = lib.mkEnableOption \"${TM_FILENAME_BASE}\";",
      "\t};",
      "",
      "\tconfig = lib.mkIf mod.enable {",
      "\t\tusers.users.\\${currentUser}.packages = [",
      "\t\t\tpkgs.${1:${TM_FILENAME_BASE}}",
      "\t\t];",
      "\t};",
      "}"
    ]
  }
}
